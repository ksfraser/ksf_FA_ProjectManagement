{
    "name": "ksfraser/ksf-fa-projectmanagement",
    "description": "FA module adapter",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ksfraser/ksf-fa-common": "^1.0",
        "ksfraser/ksf-common-db": "^1.0",
        "ksfraser/html": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\": "src/Ksfraser/FrontAccounting/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ksfraser/html",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
