{
    "name": "ksfraser/ksf-fa-projectmanagement",
    "description": "FA module adapter",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ksfraser/html": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\": "src/Ksfraser/FrontAccounting/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ksfraser/html",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable"
}
